# Copy this file to `.env` and fill in your keys.
# `.env` is gitignored. Never commit real keys.

# TypeSafe / Jev — the judge. Required when JUDGE=jev (the default).
# Get one at https://typesafe.ai
TYPESAFE_API_KEY=

# Anthropic — only needed to run the LLM agent from the control panel.
# The gateway bench does not use it.
ANTHROPIC_API_KEY=

# Which judge the gateway uses:
#   jev   real TypeSafe calls (needs TYPESAFE_API_KEY)
#   mock  deterministic stand-in, no key, no network — good for offline / CI
#   none  forwards everything, only logs — the blind baseline
JUDGE=jev
